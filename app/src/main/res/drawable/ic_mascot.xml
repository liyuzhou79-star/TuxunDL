<!--
  Static mascot mark: a minimal Android-style robot head. Two antennae;
  the right one ends in a larger "node" dot (the proxy node) instead of
  a plain ball. Used where Compose is unavailable (widget, notification);
  the animated Compose version lives in ui/Mascot.kt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- left antenna -->
    <path
        android:pathData="M17,15 L12,7"
        android:strokeColor="#FF444444"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M8.5,7 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FF444444" />
    <!-- right antenna with the node dot -->
    <path
        android:pathData="M31,15 L36,7"
        android:strokeColor="#FF444444"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31.5,7 a4.5,4.5 0 1,1 9,0 a4.5,4.5 0 1,1 -9,0"
        android:fillColor="#FF444444" />
    <!-- head -->
    <path
        android:pathData="M14,14 h20 a6,6 0 0 1 6,6 v14 a6,6 0 0 1 -6,6 H14 a6,6 0 0 1 -6,-6 V20 a6,6 0 0 1 6,-6 Z"
        android:fillColor="#FF444444" />
    <!-- eyes -->
    <path
        android:pathData="M16.4,27 a2.6,2.6 0 1,1 5.2,0 a2.6,2.6 0 1,1 -5.2,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M26.4,27 a2.6,2.6 0 1,1 5.2,0 a2.6,2.6 0 1,1 -5.2,0"
        android:fillColor="#FFFFFFFF" />
</vector>
